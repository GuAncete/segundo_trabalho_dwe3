@html.extend('layout', function(model) {
  @html.block('content', function(model) {
    
    <h1 class="mt-4">@model.title</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Listagem de motos cadastradas</li>
    </ol>

    <div class="mb-3">
        <a href="/moto/insert" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nova Moto
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-motorcycle me-1"></i>
            Motos
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Modelo</th>
                        <th>Marca</th>
                        <th>Ano</th>
                        <th>Proprietário (Cliente)</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @model.data.forEach(function(moto) {
                        <tr>
                            <td>@moto.modelo_moto</td>
                            <td>@moto.marca_moto</td>
                            <td>@moto.ano_moto</td>
                            <td>@moto.nome_cliente</td> <td>
                                <a href="/moto/update/@moto.id_moto" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            </td>
                        </tr>
                    })
                </tbody>
            </table>
        </div>
    </div>

    @if(model.message) {
        <div class="alert alert-danger" role="alert">
            @model.message
        </div>
    }

  })
})