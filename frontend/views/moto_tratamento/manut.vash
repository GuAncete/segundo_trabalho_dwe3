@html.extend('layout', function(model) {
  @html.block('content', function(model) {
    
    <h1 class="mt-4">@model.title</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Listagem de Ordens de Serviço</li>
    </ol>

    <div class="mb-3">
        <a href="/moto_tratamento/insert" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nova O.S.
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header"><i class="fas fa-file-invoice me-1"></i> Registros</div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Moto</th>
                        <th>Serviço Realizado</th>
                        <th>Valor</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @model.data.forEach(function(item) {
                        <tr>
                            <td>@item.modelo_moto</td> <td>@item.nome_tratamento</td> <td>R$ @item.valor_tratamento</td>
                            <td>
                                <a href="/moto_tratamento/update/@item.id_moto_tratamento" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            </td>
                        </tr>
                    })
                </tbody>
            </table>
        </div>
    </div>
  })
})
