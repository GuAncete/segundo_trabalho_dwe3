@html.extend('layout', function(model) {
  @html.block('content', function(model) {
    
    <h1 class="mt-4">@model.title</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Listagem de clientes cadastrados</li>
    </ol>

    <div class="mb-3">
        <a href="/cliente/insert" class="btn btn-primary">
            <i class="fas fa-plus"></i> Novo Cliente
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Clientes
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>Email</th>
                        <th>Telefone</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @model.data.forEach(function(cliente) {
                        <tr>
                            <td>@cliente.nome_cliente</td>
                            <td>@cliente.cpf_cliente</td>
                            <td>@cliente.email_cliente</td>
                            <td>@cliente.telefone_cliente</td>
                            <td>
                                <a href="/cliente/update/@cliente.id_cliente" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            </td>
                        </tr>
                    })
                </tbody>
            </table>
        </div>
    </div>

    @if(model.message) {
        <div class="alert alert-danger" role="alert">
            @model.message
        </div>
    }

  })
})